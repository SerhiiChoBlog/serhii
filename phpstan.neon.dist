includes:
	- ./vendor/nunomaduro/larastan/extension.neon

parameters:
	paths:
		- app
	level: 8
	checkMissingIterableValueType: false
	excludePaths:
		- ./*/*/FileToBeExcluded.php
	ignoreErrors:
		- '/Parameter #2 \$operator of method Illuminate\\Database\\Eloquent\\Builder<.*>::whereDate\(\) expects string, Illuminate\\Support\\Carbon given\./'
		- '/Parameter #\d \$.* of method Illuminate\\Database\\Eloquent\\Relations\\.*<App\\Models\\.*>::whereDate\(\) expects string, Illuminate\\Support\\Carbon given\./'
		- '/Parameter #1 \$message of static method Illuminate\\Log\\Logger::(warning|info|error|debug)\(\) expects array\|Illuminate\\Contracts\\Support\\Arrayable\|Illuminate\\Contracts\\Support\\Jsonable\|Illuminate\\Support\\Stringable\|string, .* given\./'
		- '/Call to an undefined method GuzzleHttp\\Promise\\PromiseInterface\|Illuminate\\Http\\Client\\Response::(throw|failed|collect)\(\)\./'
