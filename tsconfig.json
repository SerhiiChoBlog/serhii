{
    "compilerOptions": {
        "target": "es5",
        "module": "commonjs",
         "lib": ["es2021", "dom", "WebWorker"],
        "sourceMap": true,
        "removeComments": true,
        "noEmitOnError": true,
        "strict": true,
        "noImplicitAny": false,
        "paths": {
            "@/*": ["./resources/ts/main/*"],
            "@admin/*": ["./resources/ts/admin/*"],
            "@user/*": ["./resources/ts/user/*"],
            "@shared/*": ["./resources/ts/shared/*"]
        },
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    }
}
