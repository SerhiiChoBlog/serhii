{
    "name": "serhii/serhii",
    "type": "project",
    "license": "proprietary",
    "description": "Serhii personal website",
    "keywords": ["portfolio", "blog"],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "doctrine/dbal": "^3.6.0",
        "erusev/parsedown": "^1.7.4",
        "guzzlehttp/guzzle": "^7.5.0",
        "intervention/image": "^2.7.2",
        "multiavatar/multiavatar-php": "^1.0.5",
        "pusher/pusher-php-server": "^7.2.2",
        "spatie/laravel-sitemap": "^6.2.5",
        "stevebauman/location": "^6.6.1",
        "laravel/framework": "^10.0.3",
        "laravel/ui": "^4.2.1",
        "serhii/ago": "^3.0.3",
        "serhii/short-number": "^3.0.2"
    },
    "require-dev": {
        "laravel/tinker": "^2.8",
        "laravel/pint": "^1.5",
        "fakerphp/faker": "^1.21.0",
        "mockery/mockery": "^1.5.1",
        "nunomaduro/collision": "^7.0.5",
        "larastan/larastan": "^2.8.1",
        "phpunit/phpunit": "^10.0.10",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
        "post-create-project-cmd": "@php artisan key:generate --ansi",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pint": "./vendor/bin/pint",
        "stan": "@php -d memory_limit=2G ./vendor/bin/phpstan analyse",
        "test": [
            "rm -f database/database.sqlite",
            "touch database/database.sqlite",
            "./vendor/bin/phpunit"
        ],
        "check": ["@pint", "@stan", "@test"],
        "build": [
            "yarn build",
            "git add .",
            "git commit -m 'Compiled for production'"
        ],
        "sitemap": "@php artisan make:generate",
        "cache": [
            "@php artisan optimize:clear",
            "@php artisan config:cache",
            "@php artisan view:cache",
            "@php artisan route:cache",
            "@php artisan cache:clear",
            "@php artisan optimize"
        ],
        "cache-clear": [
            "@php artisan config:clear",
            "@php artisan view:clear",
            "@php artisan route:clear",
            "@php artisan cache:clear",
            "@php artisan optimize:clear"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
