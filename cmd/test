#!/usr/bin/env bash
set -euo pipefail

echo "🐧 Making sure .env file exists..."
if [[ ! -f app/.env ]]; then
    cp app/.env.example app/.env
fi

echo "🐧 Changing file modes..."
chmod -R +x cmd

echo "🐧 Building a dev podman image..."
./cmd/run dev build

echo "🐧 Installing composer dependencies..."
./cmd/run dev run --rm php bash -c "composer install -n && composer update -n"

echo "🐧 Building assets..."
./cmd/run dev run --rm php bash -c "npm i && npm run build"

echo "🐧 Starting a dev container..."
./cmd/run dev down
./cmd/run dev up -d

echo "🐧 Generating app key..."
if ! grep -q APP_KEY=base64: app/.env; then
    ./cmd/run dev exec php php artisan key:generate
fi

echo "🐧 Creating database if doesn't exist..."
db_file=app/database/database.sqlite
if [[ ! -f "$db_file" ]]; then
    touch "$db_file"
    ./cmd/run dev exec \
        -e DB_CONNECTION=sqlite \
        -e DB_DATABASE=database/database.sqlite \
        php php artisan migrate
fi

echo "🐧 Running checks..."
./cmd/run dev exec \
    -e DB_CONNECTION=sqlite \
    -e DB_DATABASE=database/database.sqlite \
    php composer check

echo "🐧 Cleaning up..."
./cmd/run dev down
