#!/usr/bin/env bash
set -euo pipefail

read -p "Enter destination IP: " ip

./cmd/run prod build

echo "Pusing images to Docker Hub..."
podman push serhiicho/serhiicho:nginx-prod
podman push serhiicho/serhiicho:php-prod
podman push serhiicho/serhiicho:db-prod

git push

echo "Transfering files to the VPS..."

cmd_files=(
    cmd/restart
    cmd/run
    cmd/start
    cmd/fetch
)

scp "${cmd_files[@]}" "serhii@$ip:/home/serhii/serhiicho.com/cmd/"

root_files=(
    compose.prod.yml
    compose.yml
)

scp "${root_files[@]}" "serhii@$ip:/home/serhii/serhiicho.com/"
