#!/usr/bin/env bash
set -euo pipefail

read -p "Enter destination IP: " ip

./cmd/run prod build

echo "Pusing images to Docker Hub..."
podman push serhiicho/serhiicho:nginx-prod
podman push serhiicho/serhiicho:php-prod

git push

# Deploy files
transfer_files=(
    compose.prod.yml
    compose.yml
    cmd/reload
    cmd/run
    cmd/start
)

echo "Transfering several files to the VPS..."
scp "${transfer_files[@]}" "serhii@$ip:/home/serhii/serhiicho.com/cmd/"
