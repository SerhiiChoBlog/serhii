#! /usr/bin/env bash

if [[ "$1" != "dev" && "$1" != "prod" ]]; then
    echo "Error: must be 'dev' or 'prod'"
    echo "Usage: ./run {dev|prod} [commands...]"
    exit 1
fi

# Change permissions for app/storage to www-data
if [[ "$2" == "up" ]] ;then
    podman unshare chown -R 82:82 app/storage
fi

podman-compose -f compose.yml -f "compose.${1}.yml" --env=app/.env "${@:2}"
